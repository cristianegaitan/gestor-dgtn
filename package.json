{
  "name": "gestor-dgtn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
